{
  "version": "1.0.0",
  "id": "@shopgate/custom-fonts",
  "configuration": {
    "url": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "required": false,
        "type": "textbox",
        "label": "Please provide url for font import. E.x. https://fonts.googleapis.com/css?family=Roboto:400,400i,500,700,900&subset=latin-ext"
      }
    },
    "rules": {
      "type": "admin",
      "destination": "frontend",
      "default": {},
      "params": {
        "required": false,
        "type": "json",
        "label": "Additional css params for <body> element. Please use glamor style (camelCase, no prefixes)"
      }
    },
    "typography": {
      "type": "admin",
      "destination": "frontend",
      "default": {},
      "params": {
        "required": false,
        "type": "json",
        "label": "Additional typography params applied to the theme that's available from PWA >= 7.29.0."
      }
    }
  },
  "components": [
    {
      "id": "CustomFont",
      "type": "portals",
      "path": "frontend/portals/CustomFont",
      "target": "app.globals"
    },
    {
      "id": "Subscribers",
      "path": "frontend/subscriptions.js",
      "type": "subscribers"
    }
  ]
}
